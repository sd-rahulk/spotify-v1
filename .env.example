# Copy to .env at the workspace root for the Fastify app.
NODE_ENV=development
HOST=127.0.0.1
PORT=4100
PUBLIC_API_URL=http://localhost:4100
WEB_ORIGIN=http://localhost:3000
MONGO_URI=
MONGO_DB=resonant
OWNER_PASSWORD=
APP_SECRET=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STORAGE_QUOTA=8000000000
MAX_FILE_BYTES=536870912

# Put API_ORIGIN in apps/web/.env.local for another API host.
# API_ORIGIN=http://localhost:4100

# Vercel API project only. Generate a separate random secret.
# CRON_SECRET=
